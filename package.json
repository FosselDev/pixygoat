{
  "name": "pixygoat",
  "version": "0.1.0",
  "private": true,
  "description": "PixyGoat - a local, browser-based LPC pixel-art character designer with paper-doll export.",
  "author": "Fossel",
  "repository": {
    "type": "git",
    "url": "https://github.com/FosselDev/pixygoat.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build --workspace @pixygoat/app && tsx packages/server/src/main.ts",
    "dev": "concurrently -n server,app -c blue,magenta \"tsx watch packages/server/src/main.ts --dev\" \"npm run dev --workspace @pixygoat/app\"",
    "build": "npm run build --workspace @pixygoat/app",
    "catalog": "tsx packages/server/src/cli/build-catalog.ts",
    "typecheck": "tsc -b packages/core packages/server packages/app",
    "test": "vitest run",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
